# ------------------------------------------------------------------------------
# Phoenix AI — Burn & Wound Care Assessment Tool
# Environment variable template (copy to nextjs_space/.env for local development)
#
# NEVER commit a real .env file. Only this template is tracked in git.
# On Azure, these are supplied via App Service / Container Apps app settings,
# and secrets are sourced from Azure Key Vault — never from a committed file.
# ------------------------------------------------------------------------------

# --- LLM / AI provider -------------------------------------------------------
# Phoenix AI calls Azure OpenAI (Microsoft Foundry) via the portable AI provider
# layer (lib/ai). Azure OpenAI is the single production backend.
#
# The deployment must be a vision-capable model (e.g. gpt-4o) to preserve
# multimodal image analysis.
# Used by: app/api/analyze-wound, hcp-chat, community-chat, community-analyze.
#
# Authentication is MANAGED IDENTITY by default (preferred): no key is stored;
# a bearer token is acquired via DefaultAzureCredential (managed identity in
# Azure — user-assigned selected by AZURE_CLIENT_ID; Azure CLI locally).
# An API key is an EXPLICIT, TEMPORARY fallback only.
#
# Resource endpoint, e.g. https://<resource>.openai.azure.com  (or a Foundry
# AI Services endpoint). Alternatively set AZURE_AI_PROJECT_ENDPOINT.
AZURE_AI_ENDPOINT=
# Foundry project endpoint (use instead of AZURE_AI_ENDPOINT when applicable).
AZURE_AI_PROJECT_ENDPOINT=
# Deployment (model) name to send the request to.
AZURE_AI_MODEL_DEPLOYMENT=
# Optional; defaults to 2024-10-21 when unset.
AZURE_AI_API_VERSION=
# Auth mode: `identity` (default, preferred) or `key` (temporary fallback).
AZURE_AI_AUTH=identity
# Client ID of a USER-ASSIGNED managed identity (omit for system-assigned / CLI).
AZURE_CLIENT_ID=
# TEMPORARY fallback only — used when AZURE_AI_AUTH=key or a token cannot be
# acquired. Prefer managed identity; never commit a real key.
AZURE_AI_API_KEY=
# Optional: maximum accepted upload size (decoded MB) for wound images. Default 10.
AZURE_AI_MAX_IMAGE_MB=

# Legacy Azure OpenAI variable names (still accepted as fallbacks for the new
# AZURE_AI_* names above, to avoid breaking earlier configuration).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Application URL ---------------------------------------------------------
# Used by app/layout.tsx for metadataBase (Open Graph / canonical URLs).
NEXTAUTH_URL=http://localhost:3000

# --- Authentication (demo feature flag) --------------------------------------
# AUTH_MODE selects the authentication provider (lib/auth). The first Azure
# parity release ships DEMO authentication only — a small fixed directory of
# FICTIONAL users that mirrors the original mock login. This is NOT enterprise
# authentication and is NOT suitable for production healthcare use.
#
#   demo  (default) — server-verified demo credentials + quick-login cards.
#   entra           — Microsoft Entra ID (OpenID Connect) sign-in for HCP users.
#                     Redirect-based sign-in, server-validated session cookie,
#                     middleware-protected HCP routes/APIs, and role mapping.
#                     OPT-IN: enable only once the Entra app registration below
#                     is configured. Not enabled by default for parity.
#                     See docs/security/authentication.md.
AUTH_MODE=demo
# Demo passwords are resolved SERVER-SIDE only (never shipped to the browser).
# These override the parity defaults; leave unset to keep the original demo
# passwords. DEMONSTRATION credentials only — never real accounts.
DEMO_AUTH_PASSWORD=
DEMO_AUTH_ADMIN_PASSWORD=

# --- Microsoft Entra ID (only used when AUTH_MODE=entra) ---------------------
# Register an app in Microsoft Entra ID (Azure AD). Add a Web redirect URI that
# matches AZURE_ENTRA_REDIRECT_URI exactly, and create a client secret. All
# values below are SERVER-ONLY — never expose them to the browser and never
# commit real values; on Azure supply them via app settings / Key Vault.
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=
AZURE_ENTRA_CLIENT_SECRET=
# Must equal the redirect URI registered on the Entra app, e.g.
#   http://localhost:3000/api/auth/entra/callback  (local)
#   https://<app>.azurewebsites.net/api/auth/entra/callback  (Azure)
AZURE_ENTRA_REDIRECT_URI=
# Optional — where Entra returns the browser after federated sign-out. Defaults
# to the origin of AZURE_ENTRA_REDIRECT_URI when unset.
AZURE_ENTRA_POST_LOGOUT_REDIRECT_URI=
# Optional — OIDC scopes (space-separated). Defaults to "openid profile email".
AZURE_ENTRA_SCOPES=
#
# Role mapping (Doctor / Nurse / Administrator). PREFERRED: define App Roles on
# the Entra app registration named exactly Doctor, Nurse and Administrator and
# assign users/groups to them — the "roles" claim is used automatically, no vars
# needed. FALLBACK: map Entra group object-ids to roles below (comma-separated).
# App roles take precedence over groups; role precedence is
# Administrator > Doctor > Nurse. A user with no mapped role is Forbidden.
AZURE_ENTRA_GROUP_ADMIN=
AZURE_ENTRA_GROUP_DOCTOR=
AZURE_ENTRA_GROUP_NURSE=

# --- Session (signed HCP session cookie) -------------------------------------
# SESSION_SECRET signs the httpOnly session cookie (HS256). REQUIRED when
# AUTH_MODE=entra. Must be at least 32 characters of high-entropy random data,
# e.g. generate with:  openssl rand -base64 48
# SERVER-ONLY — never expose to the browser; supply via Key Vault on Azure.
SESSION_SECRET=
# Optional — session lifetime in minutes (default 60, clamped 5..1440). Controls
# session expiration for the signed cookie.
AUTH_SESSION_TTL_MINUTES=

# --- Database (Prisma / Azure Database for PostgreSQL) -----------------------
# Prisma datasource for Azure Database for PostgreSQL Flexible Server. The
# database layer (schema, migrations, seed, health/readiness) is provisioned and
# seeded with fictional demonstration data, but the visible UI still renders the
# original in-app demo content — parity is preserved until a later wiring step.
#
# DATABASE_URL is SERVER-ONLY. Never expose it to the browser and never commit a
# real value; on Azure supply it via app settings / Key Vault.
#
# Format (SSL is REQUIRED by Azure):
#   postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/phoenix?sslmode=require
#
# lib/db.ts auto-appends sslmode=require and modest pool defaults
# (connection_limit=5, pool_timeout=15, connect_timeout=15) when absent. Override
# by adding them explicitly to the query string.
DATABASE_URL=
# Optional: when routing through a connection pooler (e.g. PgBouncer), point
# DATABASE_URL at the pooler with `?pgbouncer=true` and set DIRECT_DATABASE_URL to
# the direct server endpoint for running migrations. Not required for the default
# Flexible Server setup.
# DIRECT_DATABASE_URL=

# --- Object storage (Azure Blob Storage) -------------------------------------
# The Azure-native storage layer lives in lib/storage/ (server-only). It is the
# sanctioned replacement for the removed AWS S3 helpers.
#
# NOTE: no current Phoenix AI workflow persists user files — wound/burn images are
# read client-side via FileReader and sent to the AI routes as ephemeral base64.
# The provider is therefore NOT wired into any UI workflow; these variables are
# only needed if a future feature genuinely requires persisted files.
#
# Authentication is MANAGED IDENTITY only (DefaultAzureCredential) — no account key
# is ever read, so no key can reach the browser. Reads use short-lived user
# delegation SAS URLs. The container MUST be PRIVATE (never public for clinical images).
#
# Storage account name (URL is derived as https://<name>.blob.core.windows.net) ...
AZURE_STORAGE_ACCOUNT=
# ... or provide the full blob endpoint explicitly (takes precedence).
AZURE_STORAGE_ACCOUNT_URL=
# Private container name (default: clinical-uploads).
AZURE_STORAGE_CONTAINER=
# Optional: maximum accepted upload size in MB (default 15).
AZURE_STORAGE_MAX_FILE_MB=
# The user-assigned managed identity client id (AZURE_CLIENT_ID, shared with the AI
# provider) selects the identity for storage access when set.
