# ------------------------------------------------------------------------------
# Phoenix AI — Burn & Wound Care Assessment Tool
# Environment variable template (copy to nextjs_space/.env for local development)
#
# NEVER commit a real .env file. Only this template is tracked in git.
# On Azure, these are supplied via App Service / Container Apps app settings,
# and secrets are sourced from Azure Key Vault — never from a committed file.
# ------------------------------------------------------------------------------

# --- LLM / AI provider -------------------------------------------------------
# Phoenix AI calls Azure OpenAI (Microsoft Foundry) via the portable AI provider
# layer (lib/ai). Azure OpenAI is the single production backend.
#
# The deployment must be a vision-capable model (e.g. gpt-4o) to preserve
# multimodal image analysis.
# Used by: app/api/analyze-wound, hcp-chat, community-chat, community-analyze.
#
# Authentication is MANAGED IDENTITY by default (preferred): no key is stored;
# a bearer token is acquired via DefaultAzureCredential (managed identity in
# Azure — user-assigned selected by AZURE_CLIENT_ID; Azure CLI locally).
# An API key is an EXPLICIT, TEMPORARY fallback only.
#
# Resource endpoint, e.g. https://<resource>.openai.azure.com  (or a Foundry
# AI Services endpoint). Alternatively set AZURE_AI_PROJECT_ENDPOINT.
AZURE_AI_ENDPOINT=
# Foundry project endpoint (use instead of AZURE_AI_ENDPOINT when applicable).
AZURE_AI_PROJECT_ENDPOINT=
# Deployment (model) name to send the request to.
AZURE_AI_MODEL_DEPLOYMENT=
# Optional; defaults to 2024-10-21 when unset.
AZURE_AI_API_VERSION=
# Auth mode: `identity` (default, preferred) or `key` (temporary fallback).
AZURE_AI_AUTH=identity
# Client ID of a USER-ASSIGNED managed identity (omit for system-assigned / CLI).
AZURE_CLIENT_ID=
# TEMPORARY fallback only — used when AZURE_AI_AUTH=key or a token cannot be
# acquired. Prefer managed identity; never commit a real key.
AZURE_AI_API_KEY=
# Optional: maximum accepted upload size (decoded MB) for wound images. Default 10.
AZURE_AI_MAX_IMAGE_MB=

# Legacy Azure OpenAI variable names (still accepted as fallbacks for the new
# AZURE_AI_* names above, to avoid breaking earlier configuration).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- Application URL ---------------------------------------------------------
# Used by app/layout.tsx for metadataBase (Open Graph / canonical URLs).
NEXTAUTH_URL=http://localhost:3000

# --- Database (Prisma / PostgreSQL) ------------------------------------------
# NOTE: Prisma schema exists but is NOT wired into the runtime UI in the source
# app (all dashboard/article/guideline data is mock/hardcoded client-side).
# Kept for parity; only needed if/when persistence is enabled.
DATABASE_URL=

# --- Object storage (currently AWS S3 in source) -----------------------------
# NOTE: lib/s3.ts helpers exist but are NOT wired into the runtime UI in the
# source app (images are read client-side via FileReader and sent as base64).
# Kept for parity; will be migrated to Azure Blob Storage only if persistence
# of uploads is required.
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
