%% Phoenix AI — Current (AS-IS) data-flow diagram
%% Reflects actual API routes and the AI provider layer at HEAD.
%% Blob Storage is shown as OPTIONAL because no current workflow persists user files
%% (inference payloads are ephemeral; the original HCP client may make a separate
%% Entra-session-authorized retention request after analysis).
flowchart TB
    subgraph HCPChat["HCP Chat"]
        U1["User"] --> UI1["HCP Chat UI"]
        UI1 --> L1["EN/BM selection"]
        L1 --> R1["/api/hcp-chat"]
        R1 --> P1["lib/ai prompts: hcp-chat + language instruction"]
        P1 --> AP1["AI Provider (AzureFoundryProvider)"]
        AP1 --> F1["Microsoft Foundry / Azure OpenAI"]
        F1 --> S1["Streaming SSE response"]
        S1 --> UI1
    end

    subgraph HCPAnalysis["HCP Wound Analysis"]
        U2["User"] --> IMG2["Image upload (base64, one-or-many)"]
        IMG2 --> L2["Shared original/v2 request + SSE parser\nEN/BM selection"]
        L2 --> R2["/api/analyze-wound"]
        R2 --> V2["Image validation (lib/ai/validation/image-input)"]
        V2 --> AP2["AI Provider (multimodal, consolidated TBSA)"]
        AP2 --> F2["Microsoft Foundry (gpt-4o vision)"]
        F2 --> SV2["Structured response validation (wound-analysis-schema)"]
        SV2 --> UI2["HCP Result Panel\nbilingual PDPA + decision-support notice"]
        R2 -.->|"Entra session only: persist AnalysisRecord"| DB2["PostgreSQL (lib/analysis/history)"]
        R2 -.->|"Entra session only: private image"| BLOB2["Azure Blob Storage"]
    end

    subgraph CommChat["Community Chat"]
        U3["User"] --> UI3["Community Chat UI"]
        UI3 --> R3["/api/community-chat"]
        R3 --> P3["lib/ai prompts: community-chat"]
        P3 --> AP3["AI Provider"]
        AP3 --> F3["Microsoft Foundry"]
        F3 --> S3["Response"]
        S3 --> UI3
    end

    subgraph CommImage["Community Image Check"]
        U4["User"] --> IMG4["Image (base64)"]
        IMG4 --> R4["/api/community-analyze"]
        R4 --> V4["Image validation"]
        V4 --> AP4["AI Provider (multimodal)"]
        AP4 --> F4["Microsoft Foundry (gpt-4o vision)"]
        F4 --> SG4["Safe simplified guidance (community schema)"]
        SG4 --> UI4["Community interface"]
    end
