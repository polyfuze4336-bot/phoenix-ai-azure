%% Phoenix AI — Current (AS-IS) AI architecture
%% Shows the actual AI provider abstraction (lib/ai), prompt separation, streaming,
%% multimodal one-or-many image input, and structured-output validation.
flowchart TB
    subgraph Interfaces["Client Interfaces"]
        HCPUI["HCP Interface\npersistent top Acute Burn / General Wound selector"]
        COMMUI["Community Interface\n(chat + guided burn assessment)"]
    end

    subgraph Routes["Next.js API Routes"]
        RHCPCHAT["/api/hcp-chat\n(mode-aware, validated EN/MS)"]
        RHCPAN["/api/analyze-wound\n(explicit mode, validated EN/MS;\n30s default + validated transient fallback;\nsafe correlation/filter failure diagnostics;\nfailed output never reported completed)"]
        RHCPTRANS["/api/analyze-wound/translate\n(text-only existing result)"]
        RCOMCHAT["/api/community-chat\n(validated EN/MS)"]
        RCOMBURN["/api/community-burn\n(validated image + advisory observation)"]
    end

    subgraph Prompts["Prompt Layer (lib/ai/prompts)"]
        PHCPCHAT["hcp-chat\n(clinical, detailed, EN/MS narrative)"]
        PHCPAN["hcp-wound-analysis\n(single-pass fallback, EN/MS narrative)"]
        PGENERAL["general-wound-analysis\n(own schema, no burn calculations)"]
        PCOMCHAT["community-chat\n(plain-language, safe)"]
        subgraph StagedPrompts["Staged analysis prompts"]
            PS1["wound-visual-observation"]
            PS2["wound-clinical-interpretation"]
            PS3["wound-management"]
            PS4["wound-analysis-critic"]
        end
    end

    subgraph Pipeline["Staged Analysis Pipeline (lib/ai/analysis)"]
        ORCH["runAnalysisPipeline\n(core observation + interpretation required)\n(optional management/critic degradation)"]
        DETCALC["Deterministic calc\nlib/clinical/parkland + tbsa\n(no assumed weight)"]
        SCHEMA["mode-specific Zod schemas\nTIMERS, confidence, gaps"]
        MODELSEL["model-config\nAZURE_AI_ANALYSIS_MODEL_DEPLOYMENT"]
    end

    subgraph Provider["AI Provider Abstraction (lib/ai)"]
        FACTORY["getAiProvider()"]
        AZPROV["AzureFoundryProvider"]
        CRED["azure-credential\n(DefaultAzureCredential)"]
        OAICOMPAT["openai-compatible mapping\n3 attempts + bounded timeout\nretry only transient status/network"]
        VALIN["validation/image-input\nJPEG/PNG/WebP/GIF + MIME/base64/signature\ndecode/dimensions/integrity before model"]
        VALOUT["Mode-specific Zod + JSON extraction\none repair; invalid core fails"]
        STREAM["streaming/sse + collect + text-stream\nempty/interrupted error categories"]
        TEL["ai/telemetry\nsafe correlation + allowlisted filter dimensions"]
        LANG["language\nstrict instruction + detection\none bounded rewrite"]
    end

    subgraph Azure["Azure AI"]
        FOUNDRY["Microsoft Foundry / Azure OpenAI"]
        MODEL["gpt-4o deployment (vision + text)\napi-version 2024-10-21\nViolence input annotate-only;\noutput + other filters retained"]
    end

    APPINS["Application Insights"]

    ASSURE["AI Assurance controls\nlib/rai/controls.ts + documentation\n(see current-ai-assurance.mmd)"]

    HCPUI --> RHCPCHAT
    HCPUI --> RHCPAN
    HCPUI -->|"language switch; no image"| RHCPTRANS
    COMMUI --> RCOMCHAT
    COMMUI -->|"questionnaire first, optional image"| RCOMBURN
    RCOMBURN --> VALIN
    RCOMBURN --> FACTORY

    RHCPCHAT --> PHCPCHAT --> FACTORY
    RHCPAN --> ORCH
    RHCPTRANS --> LANG
    ORCH --> PS1 --> FACTORY
    ORCH --> PS2 --> FACTORY
    ORCH --> PS3 --> FACTORY
    ORCH --> PS4 --> FACTORY
    ORCH --> DETCALC
    ORCH --> SCHEMA
    RHCPAN -->|"general_wound"| PGENERAL --> FACTORY
    ORCH --> MODELSEL
    MODELSEL --> AZPROV
    RHCPAN -.->|"single mode or one transient Acute Burn fallback"| PHCPAN --> FACTORY
    RCOMCHAT --> PCOMCHAT --> FACTORY

    RHCPAN --> VALIN
    VALIN --> FACTORY

    FACTORY --> LANG --> AZPROV
    AZPROV --> CRED
    AZPROV --> OAICOMPAT
    OAICOMPAT -->|"managed identity token"| FOUNDRY
    FOUNDRY --> MODEL

    MODEL --> STREAM
    STREAM --> HCPUI
    STREAM --> COMMUI

    SCHEMA --> VALOUT
    MODEL --> VALOUT
    VALOUT --> HCPUI

    AZPROV --> TEL
    TEL --> APPINS

    SCHEMA -.->|"controls surfaced"| ASSURE
    VALOUT -.->|"controls surfaced"| ASSURE
    TEL -.->|"controls surfaced"| ASSURE
