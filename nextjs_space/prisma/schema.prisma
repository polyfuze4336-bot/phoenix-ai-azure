generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Datasource: Azure Database for PostgreSQL Flexible Server.
// TLS is required; lib/db.ts appends sslmode=require and pool defaults to
// DATABASE_URL. Migrations are applied via the controlled `prisma migrate deploy`
// step (see .github/workflows/deploy.yml), never a destructive reset.
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Case {
  id              String   @id @default(cuid())
  caseType        String   // BURN, DIABETIC_ULCER, PRESSURE_ULCER, TRAUMATIC_WOUND, SURGICAL_WOUND
  burnDegree      String?  // 1ST, 2ND_SUPERFICIAL, 2ND_DEEP, 3RD, 4TH
  severity        String   // MILD, MODERATE, SEVERE, CRITICAL
  tbsaPercent     Float?
  bodyRegion      String?
  confidence      Float?
  ageGroup        String?
  outcome         String?  // HEALED, ONGOING, REFERRED, COMPLICATED
  characteristics String?
  recommendations String?
  imageKey        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([caseType])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  portal    String   // HCP, COMMUNITY
  role      String   // user, assistant
  content   String
  imageKey  String?
  sessionId String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([portal])
}

// Persisted HCP AI wound-analysis results, retained for later reference on the
// clinician history page. The full structured assessment is stored as JSON; a few
// summary columns are denormalised for fast list rendering. `imageKey` is the
// private Blob Storage path for the analysed image (served via short-lived SAS).
model AnalysisRecord {
  id             String   @id @default(cuid())
  clinicianName  String?
  clinicianEmail String?
  imageKey       String?
  imageMimeType  String?
  woundCategory  String?
  woundType      String?
  burnDegree     String?
  severity       String?
  confidence     String?
  tbsaEstimate   String?
  isBurn         Boolean  @default(false)
  result         Json
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model Article {
  id          String   @id @default(cuid())
  titleEn     String
  titleBm     String
  contentEn   String
  contentBm   String
  summaryEn   String
  summaryBm   String
  category    String
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
