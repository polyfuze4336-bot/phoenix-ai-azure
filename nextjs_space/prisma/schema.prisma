generator client {
    provider = "prisma-client-js"
}

// Datasource: Azure Database for PostgreSQL Flexible Server.
// TLS is required; lib/db.ts appends sslmode=require and pool defaults to
// DATABASE_URL. Migrations are applied via the controlled `prisma migrate deploy`
// step (see .github/workflows/db-migrate.yml), never a destructive reset.
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Case {
  id              String   @id @default(cuid())
  caseType        String   // BURN, DIABETIC_ULCER, PRESSURE_ULCER, TRAUMATIC_WOUND, SURGICAL_WOUND
  burnDegree      String?  // 1ST, 2ND_SUPERFICIAL, 2ND_DEEP, 3RD, 4TH
  severity        String   // MILD, MODERATE, SEVERE, CRITICAL
  tbsaPercent     Float?
  bodyRegion      String?
  confidence      Float?
  ageGroup        String?
  outcome         String?  // HEALED, ONGOING, REFERRED, COMPLICATED
  characteristics String?
  recommendations String?
  imageKey        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([caseType])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  portal    String   // HCP, COMMUNITY
  role      String   // user, assistant
  content   String
  imageKey  String?
  sessionId String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([portal])
}

model Article {
  id          String   @id @default(cuid())
  titleEn     String
  titleBm     String
  contentEn   String
  contentBm   String
  summaryEn   String
  summaryBm   String
  category    String
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
